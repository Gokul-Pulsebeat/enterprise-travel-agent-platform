# Copy this file to `.env` and adjust. `.env` is gitignored: never commit it.
#
# Where each variable is used:
#   [local]   read from the PROCESS ENVIRONMENT by the Python code when you run services directly on your
#             machine. The code does NOT load this .env file: set them in your shell instead, e.g.
#             PowerShell:  $env:LLM_PROVIDER = "mock"        bash:  export LLM_PROVIDER=mock
#   [compose] read from this .env file by docker-compose.yml for ${...} substitution
# Docker Compose reads `.env` automatically for substitution; it does NOT inject these into containers.
# The agent container's own settings (LLM_PROVIDER=mock and the API URLs) are set in docker-compose.yml.

# --- Agent / LLM provider [local] -------------------------------------------------------------
# One of: mock (no LLM, deterministic), ollama (local model), openai
LLM_PROVIDER=mock

# OpenAI (only when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Ollama (only when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=180
# If you run the agent in a container but Ollama on your host, use:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- REST API base URLs used by the MCP servers [local] ----------------------------------------
# Local development defaults. In Docker Compose these are set to http://flight_api:8000 and
# http://hotel_api:8001 on the agent service (service names resolve on the Compose network).
FLIGHT_API_BASE_URL=http://127.0.0.1:8000
HOTEL_API_BASE_URL=http://127.0.0.1:8001

# --- Postgres [compose] ------------------------------------------------------------------------
# Provisioned for SP02 (core services) and SP05 (pgvector). Not used by the code yet.
# These are LOCAL DEV defaults only; never reuse this password anywhere real.
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel_dev_password
POSTGRES_DB=travel_agent

# --- Reserved for later epics (not read by any code yet) ---------------------------------------
# DATABASE_URL=postgresql://travel:travel_dev_password@127.0.0.1:5432/travel_agent
# REDIS_URL=redis://127.0.0.1:6379/0

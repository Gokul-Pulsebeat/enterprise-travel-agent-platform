# Copy this file to `.env` and adjust. `.env` is gitignored: never commit it.
#
# Where each variable is used:
#   [local]   read from the PROCESS ENVIRONMENT by the Python code when you run services directly on your
#             machine. The code does NOT load this .env file: set them in your shell instead, e.g.
#             PowerShell:  $env:LLM_PROVIDER = "mock"        bash:  export LLM_PROVIDER=mock
#   [compose] read from this .env file by docker-compose.yml for ${...} substitution
# Docker Compose reads `.env` automatically for substitution; it does NOT inject these into containers.
# The agent container's own settings (LLM_PROVIDER=mock and the API URLs) are set in docker-compose.yml.

# --- Agent / LLM provider [local] -------------------------------------------------------------
# One of: mock (no LLM, deterministic), ollama (local model), openai
LLM_PROVIDER=mock

# OpenAI (only when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Ollama (only when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=180
# If you run the agent in a container but Ollama on your host, use:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- REST API base URLs used by the MCP servers [local] ----------------------------------------
# Local development defaults. In Docker Compose these are set to http://flight_api:8000 and
# http://hotel_api:8001 on the agent service (service names resolve on the Compose network).
FLIGHT_API_BASE_URL=http://127.0.0.1:8000
HOTEL_API_BASE_URL=http://127.0.0.1:8001

# --- Postgres [compose] ------------------------------------------------------------------------
# The database both REST APIs use (SP02). docker-compose.yml builds each API's DATABASE_URL from these values.
# These are LOCAL DEV defaults only; never reuse this password anywhere real. If you change the password to
# something with special characters, it must be URL-encoded inside DATABASE_URL.
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel_dev_password
POSTGRES_DB=travel_agent

# --- Database connection for the REST APIs [local] ---------------------------------------------
# Used when you run flight_api / hotel_api directly (uvicorn) or run Alembic from the CLI. Start the database with
#   docker compose up -d postgres
# If unset, this exact value is the default. In Cloud Run the Neon connection string is injected from Secret Manager;
# Neon-style URLs (postgresql://...?sslmode=require&channel_binding=require) are accepted as-is.
DATABASE_URL=postgresql://travel:travel_dev_password@127.0.0.1:5432/travel_agent

# Insert the mock flights and hotels at start-up (idempotent). Set to false to start with empty tables.
SEED_MOCK_DATA=true

# Connection pool per service instance. Keep it small: Cloud Run runs several instances and Neon's free tier
# has a connection limit.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE_SECONDS=300

# --- Tests [local] -----------------------------------------------------------------------------
# pytest uses its own databases on the same server (travel_agent_test and travel_agent_test_migrations, created
# automatically), so your development data is never touched. Override to use another server.
# TEST_DATABASE_URL=postgresql://travel:travel_dev_password@127.0.0.1:5432/travel_agent_test

# --- Reserved for later epics (not read by any code yet) ---------------------------------------
# REDIS_URL=redis://127.0.0.1:6379/0
